{
  "fixtureVersion": 1,
  "id": "declared-output",
  "description": "A command writes stdout as its output.mode declares on every outcome: one JSON value, plain text, or nothing, on success and on a dispatch failure.",
  "document": {
    "schema": "cli-contract/cli-schema/v1",
    "name": "fixture",
    "commands": {
      "emit-json": {
        "short": "write one JSON value",
        "use": "emit-json",
        "url_positional": false,
        "output": { "mode": "json", "success_exit_codes": [0] }
      },
      "emit-raw": {
        "short": "write plain text",
        "use": "emit-raw",
        "url_positional": false,
        "output": { "mode": "raw", "success_exit_codes": [0] }
      },
      "emit-none": {
        "short": "write nothing",
        "use": "emit-none",
        "url_positional": false,
        "output": { "mode": "none", "success_exit_codes": [0] }
      },
      "store": {
        "short": "store utilities",
        "use": "store",
        "url_positional": false,
        "subcommands": {
          "clear": {
            "short": "write nothing below a parent command",
            "use": "clear",
            "url_positional": false,
            "output": { "mode": "none", "success_exit_codes": [0] }
          }
        }
      }
    },
    "common_flags": {}
  },
  "cases": [
    {
      "id": "json-value",
      "argv": ["emit-json"],
      "expect": { "exit": 0, "stdout": { "class": "json-value" }, "stderr": { "class": "empty" } }
    },
    {
      "id": "plain-text",
      "argv": ["emit-raw"],
      "expect": {
        "exit": 0,
        "stdout": { "class": "plain-text", "equals": "fixture raw output\n" },
        "stderr": { "class": "empty" }
      }
    },
    {
      "id": "nothing",
      "argv": ["emit-none"],
      "expect": { "exit": 0, "stdout": { "class": "empty" }, "stderr": { "class": "empty" } }
    },
    {
      "id": "nothing-on-dispatch-failure",
      "argv": ["emit-none", "--nope"],
      "expect": {
        "exit": 2,
        "stdout": { "class": "empty" },
        "stderr": { "class": "prefix", "text": "emit-none:" }
      }
    },
    {
      "id": "plain-text-on-dispatch-failure",
      "argv": ["emit-raw", "--nope"],
      "expect": {
        "exit": 2,
        "stdout": { "class": "plain-text" },
        "stderr": { "class": "prefix", "text": "emit-raw:" }
      }
    },
    {
      "id": "nothing-on-nested-dispatch-failure",
      "argv": ["store", "clear", "--nope"],
      "expect": {
        "exit": 2,
        "stdout": { "class": "empty" },
        "stderr": { "class": "prefix", "text": "store clear:" }
      }
    }
  ]
}
